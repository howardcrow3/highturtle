# Turtlebox billing (billing/). Copy to .env for local runs; never commit real values.
# On AWS these three secrets live in Secrets Manager (BILLING_SECRET_ID below), not in Lambda env vars.

# Paddle API key (live keys start pdl_live_apikey_). Needs: customers read, customer portal sessions write.
PADDLE_API_KEY=
# Signing secret of the notification destination (Paddle > Developer tools > Notifications).
# This is NOT the API key; it starts pdl_ntfset_.
PADDLE_WEBHOOK_SECRET=
# production or sandbox
PADDLE_ENVIRONMENT=production
# Random string used to sign the Google sign-in state and the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# Google sign-in (Google Cloud > APIs & Services > Credentials > OAuth client ID, type Web application).
# Redirect URI: https://turtlebox.studio/api/billing/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hex private key that signs Backer license keys (from backer-keygen init). Optional.
BACKER_SIGNING_KEY=
BACKER_PRICE_IDS=pri_01m7esmmmhtvqh0518kmb0xqdq

# Golden (howardcrow3/golden): Paddle price IDs (not secret) and the base64url Ed25519 seed that signs its licences.
# Billing setup creates the seed in Secrets Manager if none exists and prints the public key for the app.
GOLDEN_PRICE_ID=
GOLDEN_PLAID_PRICE_ID=
GOLDEN_SIGNING_KEY=

# Name of the Secrets Manager secret holding the three values above as JSON (set on Lambda).
BILLING_SECRET_ID=
AWS_REGION=us-east-2

SITE=https://turtlebox.studio
FROM_ADDR=Turtlebox <account@turtlebox.studio>
REPLY_TO=info@turtlebox.studio
CONFIG_SET=highturtle

CUSTOMERS_TABLE=highturtle-billing-customers
SUBSCRIPTIONS_TABLE=highturtle-billing-subscriptions
TRANSACTIONS_TABLE=highturtle-billing-transactions

# What past_due means for access: grant (default, while Paddle retries the payment) or deny.
ACCESS_PAST_DUE=grant
